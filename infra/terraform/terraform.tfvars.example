# ---------------------------------------------------------
# Polymarket Collector - Terraform Variables Example
# Copy to terraform.tfvars and customize as needed.
# ---------------------------------------------------------

# Number of EC2 collector instances.
# With replication_factor=2 and chunk_size=100, each market is collected by
# 2 collectors for high availability. Each collector opens ~50 connections.
# 4 instances cover all 20,000 tokens with replica=2.
collector_count = 4

# EC2 instance type.
# t3.small  : ~$63/mo total (4x), comfortable headroom
# t3.micro  : ~$33/mo total (4x), tight but works with chunk_size=100
collector_instance_type = "t3.small"

# Tokens per WebSocket connection.
# 100 is the tested sweet spot for stable connections.
chunk_size = 100

# How many collectors each market is assigned to.
# 2 = each market collected by 2 independent collectors (high availability).
# 1 = no redundancy; a single collector failure causes data gaps.
replication_factor = 2

# Seconds before a collector is considered stale and its markets reassigned.
heartbeat_timeout_secs = 60

# Delete S3 objects after aggregator merges them into the output file.
# Set to true to save S3 storage costs; false to keep raw files for debugging.
delete_after_merge = false

# AWS region
region = "us-east-1"

# SSH key pair name
key_name = "your-key-pair"

# S3 bucket for binary artifacts and collector rotated output files.
s3_bucket = "your-polymarket-collector-bucket"

# S3 prefix for collector rotated files.
s3_prefix = "orderbook/"
